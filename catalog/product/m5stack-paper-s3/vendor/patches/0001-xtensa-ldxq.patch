diff --git a/xtensa-lx7/tests/ldxq.rs b/xtensa-lx7/tests/ldxq.rs
new file mode 100644
index 0000000..2a66dfc
--- /dev/null
+++ b/xtensa-lx7/tests/ldxq.rs
@@ -0,0 +1,81 @@
+//! EE.LDXQ.32: ESP32-S3 TRM v1.8, section 1.8.37.
+//! https://documentation.espressif.com/esp32-s3_technical_reference_manual_en.pdf
+use xtensa_lx7::{decode, pie, pie_timing, step, Cpu, FlatRam, Op, Trap};
+use xtensa_lx7::state::exc;
+
+const BASE: u32 = 0x4037_0000;
+
+fn word(qu: u32, qs: u32, sel4: u32, sel8: u32) -> u32 {
+    // Independent TRM Instruction Word layout; address register a4.
+    0xe070_0d4e | qu << 16 | (qs & 3) << 14 | (qs >> 2)
+        | (sel4 & 1) << 19 | (sel4 >> 1) << 24
+        | (sel8 & 1) << 23 | (sel8 >> 1) << 12
+}
+
+#[test]
+fn edcbook_fault_word_has_two_distinct_selectors() {
+    // Espressif xtensa-esp32s3-elf-objdump agrees for EDCBook 3.1.2 @ 0x420a0da0.
+    let raw = 0xe072_3d4e_u32;
+    assert_eq!(word(2, 0, 0, 6), raw);
+    let insn = decode(0x420a_0da0, raw.to_le_bytes());
+    assert_eq!((insn.op, insn.len), (Op::Pie, 4));
+    assert_eq!(pie::format(raw, insn.imm as usize), "ee.ldxq.32\tq2, q0, a4, 0, 6");
+    let fields = pie::OPS[insn.imm as usize].fields;
+    assert_ne!(fields[3].role, fields[4].role);
+}
+
+#[test]
+fn ldxq_loads_unsigned_indexed_word_into_only_selected_lane() {
+    let indices = [0u16, 1, 2, 4, 0x1234, 0x7fff, 0x8000, 0xffff];
+    let mut ram = FlatRam::new(BASE, 0x40100);
+    for (lane, &index) in indices.iter().enumerate() {
+        let at = 0x40 + index as usize * 4;
+        ram.mem[at..at + 4].copy_from_slice(&(0xa5fe_1020_u32 + lane as u32).to_le_bytes());
+    }
+    let source = indices.iter().enumerate().fold(0u128, |value, (lane, index)| value | (*index as u128) << (lane * 16));
+    for qu in 0..8 { for qs in 0..8 { for sel4 in 0..4 { for sel8 in 0..8 {
+        let mut cpu = Cpu::new(0); cpu.pc = BASE; cpu.cpenable = 1 << 3;
+        cpu.set_ar(4, BASE + 0x43); // Indexed address is rounded down to a word boundary.
+        cpu.qr.fill(0x0123_4567_89ab_cdef_fedc_ba98_7654_3210);
+        cpu.qr[qs as usize] = source;
+        let mut expected = cpu.qr;
+        let mask = (u32::MAX as u128) << (32 * sel4);
+        expected[qu as usize] = (expected[qu as usize] & !mask) | ((0xa5fe_1020 + sel8) as u128) << (32 * sel4);
+        let insn = decode(BASE, word(qu, qs, sel4, sel8).to_le_bytes());
+        assert_eq!(pie::exec(&mut cpu, &mut ram, &insn), Ok(()));
+        assert_eq!(cpu.qr, expected, "qu={qu} qs={qs} sel4={sel4} sel8={sel8}");
+        assert_eq!(cpu.get_ar(4), BASE + 0x43);
+        let effects = pie_timing::insn_effects(&insn);
+        assert_eq!((effects.reads, effects.writes), ((1 << qs) | (1 << qu), 1 << qu));
+    }}}}
+}
+
+#[test]
+fn ldxq_wraps_address_and_advances_pc() {
+    let mut cpu = Cpu::new(0); cpu.pc = 0x40; cpu.ps = 0; cpu.cpenable = 1 << 3;
+    cpu.set_ar(4, 0xffff_fff3); cpu.qr[0] = 4 << 96;
+    let mut ram = FlatRam::new(0, 0x100);
+    ram.mem[..4].copy_from_slice(&0x1234_5678_u32.to_le_bytes());
+    ram.mem[0x40..0x44].copy_from_slice(&0xe072_3d4e_u32.to_le_bytes());
+    step(&mut cpu, &mut ram).unwrap();
+    assert_eq!(cpu.qr[2], 0x1234_5678);
+    assert_eq!(cpu.get_ar(4), 0xffff_fff3);
+    assert_eq!(cpu.pc, 0x44);
+}
+
+#[test]
+fn ldxq_fault_and_disabled_coprocessor_preserve_destination() {
+    let mut cpu = Cpu::new(0); cpu.pc = BASE; cpu.cpenable = 1 << 3;
+    cpu.set_ar(4, BASE + 0x101); cpu.qr[0] = u128::MAX;
+    let insn = decode(BASE, word(0, 0, 3, 7).to_le_bytes());
+    let mut ram = FlatRam::new(BASE, 0x100);
+    assert!(matches!(pie::exec(&mut cpu, &mut ram, &insn), Err(Trap::Exception(_))));
+    assert_eq!(cpu.exccause, exc::LOAD_PROHIBITED);
+    assert_eq!(cpu.excvaddr, BASE + 0x400fc);
+    assert_eq!(cpu.qr[0], u128::MAX);
+    assert_eq!(cpu.get_ar(4), BASE + 0x101);
+    cpu.cpenable = 0;
+    assert!(matches!(pie::exec(&mut cpu, &mut ram, &insn), Err(Trap::Exception(_))));
+    assert_eq!(cpu.exccause, exc::COPROCESSOR0_DISABLED + 3);
+    assert_eq!(cpu.qr[0], u128::MAX);
+}
