+fn decoded(load: Option<i32>, step: i32) -> BlockInsn {
+    use crate::pie::Role::{As, Imm, Qu, Qx, Qy};
+    let encoded = match load {
+        None => asm::pie("ee.vmulas.u16.accx", &[(Qx, 0), (Qy, 1)]),
+        Some(q) => asm::pie("ee.vmulas.u16.accx.ld.ip", &[(Qx, 0), (Qy, 1), (Qu, q), (As, 4), (Imm, step)]),
+    };
+    let mut bytes = [0; 4]; bytes[..encoded.len()].copy_from_slice(&encoded);
+    let i = crate::decode::decode(BASE, bytes);
+    BlockInsn { insn: i, max_ar: crate::exec::max_ar(&i), straddle: false, off: 0 }
+}
+
+fn vector(lanes: [u16; 8]) -> u128 {
+    lanes.iter().enumerate().fold(0, |q, (k, &v)| q | u128::from(v) << (16 * k))
+}
+
+pub(super) fn run_tests() -> u32 {
+    let mut cases = vec![
+        ([u16::MAX; 8], [u16::MAX; 8], 0i64),
+        ([0x8000; 8], [0x8000; 8], -1),
+        ([0; 8], [u16::MAX; 8], -1),
+        ([u16::MAX; 8], [u16::MAX; 8], -(1i64 << 39)),
+        ([u16::MAX; 8], [u16::MAX; 8], (1i64 << 39) - 1),
+    ];
+    for lane in 0..8 { let mut x = [0; 8]; x[lane] = 0xffff; cases.push((x, [0x8001; 8], 17)); }
+    let mut tests = 0;
+    for load in [None, Some(0), Some(1), Some(2)] {
+        let mut block = [decoded(load, -16), insn(Op::Nop)];
+        assert!(emitter::supported_insn(&block[0].insn, true), "unsigned U16 ACCX must compile");
+        let mut cc = CodeCache::new(0).unwrap();
+        let code = compile(&mut cc, &mut block, BASE, true).unwrap();
+        for _ in 0..HOT { ready(&cc, code, 0); }
+        assert!(ready(&cc, code, 0));
+        for (case, &(x, y, initial)) in cases.iter().enumerate() {
+            for mode in 0..8 { for budget in [1, 2] {
+                CONTEXT.with(|c| *c.borrow_mut() = format!("unsigned U16 load={load:?} case={case} mode={mode} budget={budget}"));
+                let (mut reference, mut actual) = (cpu(15), cpu(15));
+                for c in [&mut reference, &mut actual] {
+                    c.cpenable = if mode == 5 { 0 } else { 8 };
+                    c.approximate_pie_mode = if mode >= 6 { mode - 5 } else { 0 };
+                    c.qr[0] = vector(x); c.qr[1] = vector(y); c.qr[2] = u128::MAX;
+                    c.accx = [initial as u32, ((initial >> 32) as u32 & 0xff) | 0xa5a5_a500];
+                    c.set_ar(4, match mode { 2 | 4 => SLOW, 3 => BASE + 65520, _ => BASE + 0x1003 });
+                    c.blocks.observed = true;
+                }
+                let (mut ra, mut rb) = (Ram::new(true, false), Ram::new(true, false));
+                if mode == 1 { rb.tlb.fill(TlbEntry::EMPTY); }
+                if mode == 3 {
+                    ra.ram.mem.truncate(65528); rb.ram.mem.truncate(65528);
+                    rb.tlb[tlb_index(BASE)].span = 65528; rb.tlb[tlb_index(BASE)].hi = BASE + 65528;
+                }
+                if mode == 4 { ra.defer_armed = true; rb.defer_armed = true; }
+                let fm = rb.fast_mem();
+                // SAFETY: ready code, valid entry and mapping belonging to this live bus.
+                let result = unsafe { run(&cc, code, &mut actual, &mut rb, &Helpers::new::<Ram>(), budget, 0, fm) };
+                let done = result & 0xffff; assert!(done > 0 && done <= budget);
+                let mut trap = None;
+                for bi in block.iter().take(done as usize) {
+                    let mut i = bi.insn; if i.op == Op::Pie { i.r = 0; }
+                    if load.is_some() && crate::exec::defer_instruction(&reference, &mut ra, &i) { break; }
+                    if let Err(t) = exec_insn(&mut reference, &mut ra, &i) { trap = Some(t); break; }
+                }
+                assert_eq!(trap, actual.jit_trap.take()); same(&reference, &actual);
+                assert_eq!(ra.deferred, rb.deferred); assert_eq!(ra.ram.mem, rb.ram.mem);
+                if mode != 5 && !(mode == 4 && load.is_some()) {
+                    let dot: i64 = x.iter().zip(y).map(|(&a, b)| i64::from(a) * i64::from(b)).sum();
+                    let want = (initial + dot).clamp(0, (1i64 << 40) - 1);
+                    assert_eq!(actual.accx, [want as u32, (want >> 32) as u32], "accumulate commits even when the following load faults");
+                }
+                if load.is_some() && mode == 0 { assert_eq!(rb.slow_reads, 0, "prove generated memory path ran"); }
+                tests += 1;
+            }}
+        }
+    }
+    tests + repeated() + held_boundary()
+}
+
+/// After a first result sets bit39, the next instruction must read it as negative.
+/// An unsigned or signed held ACCX sum, or signed load coalescing, loses that boundary.
+fn repeated() -> u32 {
+    let mut tests = 0;
+    for load in [None, Some(2)] {
+        let mut block = [decoded(load, 16), decoded(load, 16)];
+        let mut cc = CodeCache::new(0).unwrap();
+        let code = compile(&mut cc, &mut block, BASE, true).unwrap();
+        for _ in 0..HOT { ready(&cc, code, 0); }
+        assert!(ready(&cc, code, 0));
+        let (mut reference, mut actual) = (cpu(0), cpu(0));
+        for c in [&mut reference, &mut actual] {
+            c.cpenable = 8; c.qr[0] = u128::MAX; c.qr[1] = u128::MAX;
+            c.accx = [u32::MAX, 0x7f]; c.set_ar(4, BASE + 0x1000); c.blocks.observed = true;
+        }
+        let (mut ra, mut rb) = (Ram::new(true, false), Ram::new(true, false));
+        let fm = rb.fast_mem();
+        // SAFETY: ready whole block and live bus/mapping.
+        let result = unsafe { run(&cc, code, &mut actual, &mut rb, &Helpers::new::<Ram>(), 2, 0, fm) };
+        assert_eq!(result & 0xffff, 2); assert!(actual.jit_trap.is_none());
+        for bi in &block { let mut i = bi.insn; i.r = 0; exec_insn(&mut reference, &mut ra, &i).unwrap(); }
+        same(&reference, &actual); assert_eq!(actual.accx, [0, 0]);
+        tests += 1;
+    }
+    tests
+}
+
+/// A signed held sum must become authoritative before the unsigned instruction.
+fn held_boundary() -> u32 {
+    use crate::pie::Role::{Qx, Qy};
+    let decode = |bytes: Vec<u8>| {
+        let mut word = [0; 4]; word[..bytes.len()].copy_from_slice(&bytes);
+        let i = crate::decode::decode(BASE, word);
+        BlockInsn { insn: i, max_ar: crate::exec::max_ar(&i), straddle: false, off: 0 }
+    };
+    let mut block = [decode(asm::pie("ee.zero.accx", &[])),
+        decode(asm::pie("ee.vmulas.s8.accx", &[(Qx, 0), (Qy, 1)])), decoded(None, 0)];
+    let mut cc = CodeCache::new(0).unwrap();
+    let code = compile(&mut cc, &mut block, BASE, true).unwrap();
+    for _ in 0..HOT { ready(&cc, code, 0); }
+    assert!(ready(&cc, code, 0));
+    let (mut reference, mut actual) = (cpu(0), cpu(0));
+    for c in [&mut reference, &mut actual] {
+        c.cpenable = 8; c.qr[0] = u128::MAX; c.qr[1] = u128::MAX;
+        c.accx = [12345, 0]; c.blocks.observed = true;
+    }
+    let (mut ra, mut rb) = (Ram::new(true, false), Ram::new(true, false));
+    let fm = rb.fast_mem();
+    // SAFETY: ready whole block and live bus/mapping.
+    let result = unsafe { run(&cc, code, &mut actual, &mut rb, &Helpers::new::<Ram>(), 3, 0, fm) };
+    assert_eq!(result & 0xffff, 3); assert!(actual.jit_trap.is_none());
+    for bi in &block { let mut i = bi.insn; i.r = 0; exec_insn(&mut reference, &mut ra, &i).unwrap(); }
+    same(&reference, &actual);
+    assert_eq!(actual.accx, [0xfff0_0018, 7]); // 16 + 8 * 65535 * 65535.
+    1
+}
