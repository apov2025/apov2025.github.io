+//! EDCBook lookup instruction: generated WASM versus the independent table executor.
+use super::*;
+
+pub(super) fn run_tests() -> u32 {
+    let mut tests = 0;
+    for (qu, qs) in [(0, 0), (0, 7), (7, 0), (3, 5)] {
+        for sel4 in 0..4 { for sel8 in 0..8 {
+            // TRM encoding, independent of the operand table used by the emitter.
+            let raw: u32 = 0xe070_0d4e | qu << 16 | (qs & 3) << 14 | (qs >> 2)
+                | (sel4 & 1) << 19 | (sel4 >> 1) << 24
+                | (sel8 & 1) << 23 | (sel8 >> 1) << 12;
+            let decoded = crate::decode::decode(BASE, raw.to_le_bytes());
+            assert!(emitter::supported_insn(&decoded, true), "LDXQ must compile through the fast mapping");
+            assert!(!emitter::supported_insn(&decoded, false), "without fast memory use the interpreter");
+            let mut block = [BlockInsn { insn: decoded, max_ar: crate::exec::max_ar(&decoded), straddle: false, off: 0 }, insn(Op::Nop)];
+            let mut cc = CodeCache::new(0).unwrap();
+            let code = compile(&mut cc, &mut block, BASE, true).expect("LDXQ block must compile");
+            for _ in 0..HOT { ready(&cc, code, 0); }
+            assert!(ready(&cc, code, 0));
+            for mode in 0..10 { for budget in [1, 2] {
+                CONTEXT.with(|c| *c.borrow_mut() = format!("LDXQ q{qu},q{qs} sel={sel4}/{sel8} mode={mode} budget={budget}"));
+                let (mut reference, mut actual) = (cpu(15), cpu(15));
+                let indices = [0u16, 1, 3, 8, 127, 511, 0x8000, 0xffff];
+                let index = u32::from(indices[sel8 as usize]);
+                let target = match mode { 2 | 3 => BASE + 65532, 4 => BASE + 65536, 5 => 0, _ => BASE + 0x1000 };
+                for c in [&mut reference, &mut actual] {
+                    c.cpenable = if mode == 6 { 0 } else { 1 << 3 };
+                    c.approximate_pie_mode = if mode >= 8 { mode - 7 } else { 0 };
+                    c.blocks.observed = true;
+                    c.qr.fill(0x0123_4567_89ab_cdef_fedc_ba98_7654_3210);
+                    c.qr[qs as usize] = indices.iter().enumerate().fold(0, |q, (k, &v)| q | u128::from(v) << (k * 16));
+                    let unaligned = if mode == 7 { 1 } else { 3 };
+                    c.set_ar(4, target.wrapping_sub(index * 4).wrapping_add(unaligned));
+                }
+                let (mut ra, mut rb) = (Ram::new(true, false), Ram::new(true, false));
+                if mode == 1 { rb.tlb.fill(TlbEntry::EMPTY); }
+                if mode == 3 { rb.tlb[tlb_index(BASE)].span -= 1; rb.tlb[tlb_index(BASE)].hi -= 1; }
+                let fm = rb.fast_mem();
+                // SAFETY: ready module, valid entry, and helpers/mapping belong to this bus.
+                let result = unsafe { run(&cc, code, &mut actual, &mut rb, &Helpers::new::<Ram>(), budget, 0, fm) };
+                let done = result & 0xffff;
+                assert!(done > 0 && done <= budget);
+                let mut trap = None;
+                for bi in block.iter().take(done as usize) {
+                    let mut i = bi.insn;
+                    if i.op == Op::Pie { i.r = 0; } // Force independent table semantics.
+                    if let Err(t) = exec_insn(&mut reference, &mut ra, &i) { trap = Some(t); break; }
+                }
+                assert_eq!(trap, actual.jit_trap.take());
+                same(&reference, &actual);
+                assert_eq!(ra.ram.mem, rb.ram.mem);
+                assert_eq!(ra.versions, rb.versions);
+                let expected_reads = u32::from(matches!(mode, 1 | 3 | 4 | 5));
+                assert_eq!(rb.slow_reads, expected_reads, "fast path must avoid the bus; fallback reads once");
+                tests += 1;
+            }}
+        }}
+    }
+    tests += prefix_and_loop();
+    #[cfg(feature = "wasm-cache-inline")]
+    { tests += cache_hits(); }
+    tests
+}
+
+fn prefix_and_loop() -> u32 {
+    let i = crate::decode::decode(BASE + 3, 0xe072_3d4eu32.to_le_bytes());
+    let mut before = insn(Op::Addi); before.insn.t = 4; before.insn.s = 4; before.insn.imm = 4;
+    let mut after = insn(Op::Addi); after.insn.t = 7; after.insn.s = 7; after.insn.imm = 1;
+    let mut block = [before, BlockInsn { insn: i, max_ar: crate::exec::max_ar(&i), straddle: false, off: 0 }, after];
+    for bi in &mut block { bi.max_ar = crate::exec::max_ar(&bi.insn); }
+    let mut tests = 0;
+    for hint in [0, BASE + 7] {
+        let mut cc = CodeCache::new(0).unwrap();
+        let code = compile(&mut cc, &mut block, BASE, true).unwrap();
+        for _ in 0..HOT { ready(&cc, code, hint); }
+        assert!(ready(&cc, code, hint));
+        for mode in 0..6 { for count in [0, 3] { for budget in 1..=14 {
+            CONTEXT.with(|c| *c.borrow_mut() = format!("LDXQ prefix/loop mode={mode} count={count} budget={budget} hint={hint:x}"));
+            let (mut reference, mut actual) = (cpu(15), cpu(15));
+            for c in [&mut reference, &mut actual] {
+                c.cpenable = if mode == 3 { 0 } else { 8 };
+                c.qr[0] = 0; c.qr[2] = u128::MAX;
+                c.set_ar(4, match mode { 2 | 4 => SLOW - 4, 5 => SLOW - 12, _ => BASE + 0x1000 });
+                c.lbeg = BASE; c.lend = BASE + 7; c.lcount = count;
+            }
+            let (mut ra, mut rb) = (Ram::new(true, false), Ram::new(true, false));
+            if mode == 1 { rb.tlb.fill(TlbEntry::EMPTY); }
+            if mode == 4 { ra.defer_armed = true; rb.defer_armed = true; }
+            let fm = rb.fast_mem();
+            // SAFETY: ready module and valid entry with the live test bus.
+            let result = unsafe { run(&cc, code, &mut actual, &mut rb, &Helpers::new::<Ram>(), budget, 0, fm) };
+            let done = result & 0xffff;
+            assert!(done > 0 && done <= budget);
+            let mut trap = None;
+            // A deferred helper is counted in the return prefix but not retired by exec_insn.
+            for _ in 0..done {
+                let k = match reference.pc.wrapping_sub(BASE) { 0 => 0, 3 => 1, 7 => 2, x => panic!("unexpected PC offset {x}") };
+                let mut instruction = block[k].insn;
+                if instruction.op == Op::Pie { instruction.r = 0; }
+                if crate::exec::defer_instruction(&reference, &mut ra, &instruction) { break; }
+                if let Err(t) = exec_insn(&mut reference, &mut ra, &instruction) { trap = Some(t); break; }
+            }
+            assert_eq!(trap, actual.jit_trap.take());
+            same(&reference, &actual);
+            assert_eq!(ra.deferred, rb.deferred);
+            assert_eq!(ra.ram.mem, rb.ram.mem);
+            tests += 1;
+        }}}
+    }
+    tests
+}
