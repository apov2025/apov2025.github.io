+#[cfg(feature = "wasm-cache-inline")]
+fn cache_hits() -> u32 {
+    use emu_core::bus::FastCacheLine;
+    CACHE_PROBES.store(true, std::sync::atomic::Ordering::Relaxed);
+    let i = crate::decode::decode(BASE, 0xe072_3d4eu32.to_le_bytes());
+    let mut block = [BlockInsn { insn: i, max_ar: crate::exec::max_ar(&i), straddle: false, off: 0 }];
+    for way in 0..9 {
+        let mut ram = Ram::new(true, true); // A read-only fast mapping still serves loads.
+        ram.tlb[tlb_index(BASE)].src = 3;
+        let tag = (0x3000_0000u32 | 0x100) >> 6;
+        let slot = ((tag & 63) * 8) as usize;
+        let mut lines = vec![FastCacheLine::default(); 512];
+        if way < 8 { lines[slot + way] = FastCacheLine { tag, dirty: 0, valid: 1 }; }
+        ram.inline_cache = Some((lines, 0));
+        let mut cc = CodeCache::new(0).unwrap();
+        let code = queue(&mut cc, &mut block, BASE, true);
+        for _ in 0..HOT { ready(&cc, code, 0); }
+        assert!(ready(&cc, code, 0));
+        let mut actual = cpu(0); actual.cpenable = 8; actual.qr[0] = 0; actual.qr[2] = u128::MAX;
+        actual.set_ar(4, BASE + 0x100);
+        let mut reference = actual.clone(); let mut ra = Ram::new(true, true);
+        let fm = ram.fast_mem();
+        // SAFETY: ready module and live bus/mapping.
+        let result = unsafe { run(&cc, code, &mut actual, &mut ram, &Helpers::new::<Ram>(), 1, 0, fm) };
+        let mut table = i; table.r = 0;
+        exec_insn(&mut reference, &mut ra, &table).unwrap();
+        assert_eq!(result & 0xffff, 1); same(&reference, &actual);
+        let (lines, hits) = ram.inline_cache.as_ref().unwrap();
+        assert_eq!(*hits, u64::from(way < 8));
+        assert_eq!(ram.helper_accesses, u32::from(way == 8));
+        assert!(lines.iter().all(|line| line.dirty == 0));
+    }
+    CACHE_PROBES.store(false, std::sync::atomic::Ordering::Relaxed);
+    9
+}
