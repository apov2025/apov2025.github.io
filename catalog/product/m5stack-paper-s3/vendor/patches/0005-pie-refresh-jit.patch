+//! Interleave/deinterleave SIMD must preserve both old sources, including aliases.
+use super::*;
+
+pub(super) fn run_tests() -> u32 {
+    use crate::pie::Role::{Qs0, Qs1};
+    let mut tests = 0;
+    for name in ["ee.vzip.8", "ee.vzip.16", "ee.vzip.32", "ee.vunzip.8", "ee.vunzip.16", "ee.vunzip.32"] {
+        for a in 0..8 { for b in 0..8 {
+            let bytes = asm::pie(name, &[(Qs0, a), (Qs1, b)]);
+            let mut raw = [0; 4]; raw[..bytes.len()].copy_from_slice(&bytes);
+            let i = crate::decode::decode(BASE, raw);
+            assert!(emitter::supported_insn(&i, true), "{name} must compile");
+            let mut block = [BlockInsn { insn: i, max_ar: crate::exec::max_ar(&i), straddle: false, off: 0 }, insn(Op::Nop)];
+            let mut cc = CodeCache::new(0).unwrap();
+            let code = compile(&mut cc, &mut block, BASE, true).unwrap();
+            for _ in 0..HOT { ready(&cc, code, 0); } assert!(ready(&cc, code, 0));
+            for seed in 0..4 { for budget in [1, 2] {
+                CONTEXT.with(|c| *c.borrow_mut() = format!("{name} q{a}/q{b} seed={seed} budget={budget}"));
+                let mut reference = cpu(15); reference.cpenable = if seed == 3 { 0 } else { 8 };
+                for (n, q) in reference.qr.iter_mut().enumerate() {
+                    *q = u128::from_le_bytes(core::array::from_fn(|k| ((n * 41 + k * 13 + seed * 97) & 255) as u8));
+                }
+                let mut actual = reference.clone();
+                let (mut ra, mut rb) = (Ram::new(true, false), Ram::new(true, false));
+                let fm = rb.fast_mem();
+                // SAFETY: module and entry are ready, with the live exclusively borrowed bus.
+                let result = unsafe { run(&cc, code, &mut actual, &mut rb, &Helpers::new::<Ram>(), budget, 0, fm) };
+                let done = result & 0xffff; assert!(done > 0 && done <= budget);
+                let mut trap = None;
+                for bi in block.iter().take(done as usize) {
+                    if let Err(t) = exec_insn(&mut reference, &mut ra, &bi.insn) { trap = Some(t); break; }
+                }
+                assert_eq!(trap, actual.jit_trap.take()); same(&reference, &actual);
+                assert_eq!(rb.slow_reads, 0); tests += 1;
+            }}
+        }}
+    }
+    tests
+}
