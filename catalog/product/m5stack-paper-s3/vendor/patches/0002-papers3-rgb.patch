+#[test]
+fn lcd_rgb_routes_raw_dma_bytes_and_preserves_legacy_rgb_callback() {
+    use esp_soc::board::LcdRgbPins;
+    type Capture=Arc<Mutex<Vec<(LcdRgbPins,u32,u32,Vec<u8>)>>>;
+    struct RgbProbe(Capture);
+    impl crate::board::BoardModel for RgbProbe {
+        fn name(&self)->&'static str {"rgb-probe"}
+        fn lcd_rgb_frame(&mut self,pins:LcdRgbPins,w:u32,h:u32,data:&[u8]) {self.0.lock().unwrap().push((pins,w,h,data.to_vec()));}
+    }
+    let capture:Capture=Default::default();let mut bus=dma_bus();bus.board=Box::new(RgbProbe(capture.clone()));
+    let bytes:Vec<u8>=(0..512).map(|i|i as u8).collect();
+    bus.load_bytes(M2M_SRC,&bytes).unwrap();
+    for (offset,value) in [(0,(1<<31)|(1<<30)|(512<<12)|512),(4,M2M_SRC),(8,0)] {bus.write32(FIRST_DESC+offset,value).unwrap();}
+    bus.periph.gdma.out[0].peri_sel=5;
+    // IDF v4.4.4 gpio_reg.h FUNC_OUT_SEL +0x554; IO_MUX MCU_SEL=1.
+    for (pin,signal) in [(8,141),(10,142),(13,150),(15,151),(16,154)] {
+        bus.periph.io_mux.write(4+4*pin,1<<12);bus.periph.gpio.write(0x554+4*pin,signal);
+    }
+    bus.periph.gpio.write(0x24,(1<<8)|(1<<10)|(1<<13)|(1<<15)|(1<<16));
+    bus.periph.lcd_cam.lcd_user=1<<27;bus.periph.lcd_cam.lcd_ctrl=1<<31;bus.periph.lcd_cam.lcd_ctrl1=511<<8|511<<20;
+    let (_,_,_,cycles)=bus.periph.lcd_cam.lcd_geometry();bus.dma_lcd_step(cycles);
+    let frames=capture.lock().unwrap();assert_eq!(frames.len(),1);
+    let (pins,w,h,data)=&frames[0];assert_eq!((*w,*h,pins.width),(512,1,8));assert_eq!(*data,bytes);
+    assert_eq!((pins.data[8],pins.data[9],pins.enable,pins.hsync,pins.clock),(1<<8,1<<10,1<<13,1<<15,1<<16));
+    assert_eq!(bus.periph.lcd_cam.lcd_frames,1);assert_ne!(bus.periph.lcd_cam.int_raw&1,0);
+    struct Legacy(usize);
+    impl crate::board::BoardModel for Legacy {fn name(&self)->&'static str {"legacy"} fn lcd_frame(&mut self,w:u32,h:u32,data:&[u8]) {assert_eq!((w,h),(512,1));self.0+=data.len();}}
