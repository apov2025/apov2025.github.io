+    fn lcd_rgb_frame(&mut self,pins:LcdRgbPins,w:u32,h:u32,data:&[u8]) {
+        // C139 V1.0: D0..7=6,14,7,12,9,11,8,10; SPH13, LEH15, CL16.
+        // EPDiy lcd_driver.c init_bus_gpio / epd_lcd_start_frame: 8-bit RGB
+        // drives DATA8..15, DE shifts source data, HSYNC latches each row.
+        // Like the existing i80 model this is a digital endpoint, not analog
+        // waveform integration or per-edge CKV/RMT timing. CKV18 is an RMT
+        // clock, not OE; OE45/BST46 are checked by powered() below.
+        if pins.width!=8 || pins.clock&(1<<16)==0 || pins.enable&(1<<13)==0 || pins.hsync&(1<<15)==0 || !self.powered() || !self.panel.scanning {return;}
+        let (w,h)=(w as usize,h as usize);
+        if w<240 || w.checked_mul(h).is_none_or(|n|n>data.len()) {return;}
+        let physical=[6,14,7,12,9,11,8,10];let mut source=[0usize;8];
+        for (bit,pin) in physical.into_iter().enumerate() {
+            let Some(i)=(8..16).find(|&i|pins.data[i]&(1<<pin)!=0) else {return;};source[bit]=i-8;
+        }
+        let lut:[u16;256]=std::array::from_fn(|byte|source.iter().enumerate().fold(0,|word,(bit,i)|word|(((byte>>i)&1) as u16)<<bit));
+        for line in data[..w*h].chunks_exact(w) {
+            if self.panel.row>=540 {break;}
+            // The physical 960-source shift register retains its final 240
+            // bytes. EPDiy's leading dummy cycle shifts out; DMA pad rows stop
+            // at the end of the 540-gate scan rather than wrapping the panel.
+            let words:Vec<u16>=line[w-240..].iter().map(|b|lut[*b as usize]).collect();
+            self.panel.line(&words);self.panel.latch();
+        }
+    }
